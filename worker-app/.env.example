# Copy to .env.local and adjust. Never put API keys or secrets here:
# every VITE_* variable is bundled into the public JavaScript.

# Base URL the app calls for /ask etc.
# Leave unset in development to use the Vite proxy at /api.
# For deployed builds, set it to the backend's public HTTPS URL, e.g.
# VITE_API_BASE_URL=https://indux-backend.example.com
VITE_API_BASE_URL=

# Development only: where the Vite /api proxy forwards requests.
VITE_DEV_PROXY_TARGET=http://localhost:8000
