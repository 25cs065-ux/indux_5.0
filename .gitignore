# Python virtual environment
.venv/
venv/
ai/venv/

# Environment variables and API secrets
.env
.env.*
ai/.env

# Keep the example environment file
!.env.example

# Python cache files
__pycache__/
*.py[cod]
*.pyo

# Manual PDFs
docs/manuals/*.pdf

