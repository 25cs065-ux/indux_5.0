admin-app/uploads/

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE and OS files
.vscode/
.DS_Store
Thumbs.db

# Embedding checkpoints -- local resume files, not for version control
ingest/output/.checkpoints/